class Candidate {
    int candidateId;
    String candidateName;
    int voteCount;

    Candidate(int candidateId, String candidateName, int voteCount) {
        this.candidateId = candidateId;
        this.candidateName = candidateName;
        this.voteCount = voteCount;
    }
}

public class SecureVoteHeapSort {

    // Heapify function
    public static void heapify(Candidate[] arr, int n, int i) {
        int smallest = i;
        int left = 2 * i + 1;
        int right = 2 * i + 2;

        if (left < n && arr[left].voteCount < arr[smallest].voteCount)
            smallest = left;

        if (right < n && arr[right].voteCount < arr[smallest].voteCount)
            smallest = right;

        if (smallest != i) {
            Candidate temp = arr[i];
            arr[i] = arr[smallest];
            arr[smallest] = temp;

            heapify(arr, n, smallest);
        }
    }

    // Heap Sort
    public static void heapSort(Candidate[] arr) {
        int n = arr.length;

        // Build Min Heap
        for (int i = n / 2 - 1; i >= 0; i--)
            heapify(arr, n, i);

        // Extract elements one by one
        for (int i = n - 1; i > 0; i--) {
            Candidate temp = arr[0];
            arr[0] = arr[i];
            arr[i] = temp;

            heapify(arr, i, 0);
        }

        // Reverse array for ascending order
        for (int i = 0; i < n / 2; i++) {
            Candidate temp = arr[i];
            arr[i] = arr[n - i - 1];
            arr[n - i - 1] = temp;
        }
    }

    public static void main(String[] args) {

        System.out.println("SecureVote - Election Analytics System");
        System.out.println("--------------------------------------");

        Candidate[] candidates = {
                new Candidate(101, "Candidate A", 450),
                new Candidate(102, "Candidate B", 620),
                new Candidate(103, "Candidate C", 300),
                new Candidate(104, "Candidate D", 780),
                new Candidate(105, "Candidate E", 510)
        };

        System.out.println("\nBefore Heap Sort:");
        for (Candidate c : candidates) {
            System.out.println(c.candidateId + "  " +
                    c.candidateName + "  " +
                    c.voteCount + " votes");
        }

        // Fraud Detection
        boolean fraud = false;
        for (Candidate c : candidates) {
            if (c.voteCount < 0) {
                fraud = true;
                break;
            }
        }

        System.out.println("\nFraud Detection Check:");
        if (fraud)
            System.out.println("Fraudulent Activity Detected.");
        else
            System.out.println("No Fraudulent Activity Detected.");

        // Heap Sort
        heapSort(candidates);

        System.out.println("\nElection Results After Heap Sort:");
        for (Candidate c : candidates) {
            System.out.println(c.candidateId + "  " +
                    c.candidateName + "  " +
                    c.voteCount + " votes");
        }

        Candidate winner = candidates[candidates.length - 1];

        System.out.println("\nWinner:");
        System.out.println(winner.candidateName +
                " with " + winner.voteCount + " votes");
    }
}
