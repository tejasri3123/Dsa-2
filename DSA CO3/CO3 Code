import java.util.*;

public class SecureVoteBFS {

    private int vertices;
    private LinkedList<Integer>[] adjList;

    SecureVoteBFS(int v) {
        vertices = v;
        adjList = new LinkedList[v];

        for (int i = 0; i < v; i++) {
            adjList[i] = new LinkedList<>();
        }
    }

    void addEdge(int v, int w) {
        adjList[v].add(w);
        adjList[w].add(v);
    }

    void BFS(int startNode) {
        boolean visited[] = new boolean[vertices];

        Queue<Integer> queue = new LinkedList<>();

        visited[startNode] = true;
        queue.add(startNode);

        while (!queue.isEmpty()) {
            int node = queue.poll();
            System.out.println("Visited Node: " + node);

            for (int neighbor : adjList[node]) {
                if (!visited[neighbor]) {
                    visited[neighbor] = true;
                    queue.add(neighbor);
                }
            }
        }
    }

    void displayGraph() {
        System.out.println("Graph Connections:");
        System.out.println("0 <-> 1");
        System.out.println("0 <-> 2");
        System.out.println("1 <-> 3");
        System.out.println("1 <-> 4");
        System.out.println("2 <-> 5");
    }

    public static void main(String[] args) {

        System.out.println("SecureVote - Digital Voting System");
        System.out.println("----------------------------------\n");

        SecureVoteBFS graph = new SecureVoteBFS(6);

        graph.addEdge(0, 1);
        graph.addEdge(0, 2);
        graph.addEdge(1, 3);
        graph.addEdge(1, 4);
        graph.addEdge(2, 5);

        graph.displayGraph();

        System.out.println("\nBFS Traversal:");
        graph.BFS(0);

        System.out.println("\nFraud Detection:");
        System.out.println("Checking duplicate voting activity...");
        System.out.println("Node 4 verified.");
        System.out.println("No Fraudulent Activity Detected.");
    }
}
