import java.util.*;

class Edge {
    int source, destination, weight;

    Edge(int source, int destination, int weight) {
        this.source = source;
        this.destination = destination;
        this.weight = weight;
    }
}

public class SecureVoteBellmanFord {

    static final int V = 5; // Number of nodes

    public static void bellmanFord(List<Edge> edges, int source) {
        int[] distance = new int[V];

        Arrays.fill(distance, Integer.MAX_VALUE);
        distance[source] = 0;

        // Relax all edges V-1 times
        for (int i = 1; i < V; i++) {
            for (Edge edge : edges) {
                if (distance[edge.source] != Integer.MAX_VALUE &&
                    distance[edge.source] + edge.weight < distance[edge.destination]) {

                    distance[edge.destination] =
                            distance[edge.source] + edge.weight;
                }
            }
        }

        // Check for negative weight cycle
        boolean fraudDetected = false;
        for (Edge edge : edges) {
            if (distance[edge.source] != Integer.MAX_VALUE &&
                distance[edge.source] + edge.weight < distance[edge.destination]) {

                fraudDetected = true;
                break;
            }
        }

        System.out.println("\nShortest Distance from Main Election Server:");
        for (int i = 0; i < V; i++) {
            System.out.println("Node " + i + " -> " + distance[i]);
        }

        System.out.println("\nFraud Detection:");
        if (fraudDetected) {
            System.out.println("Fraudulent Activity Detected!");
        } else {
            System.out.println("No Fraudulent Activity Detected.");
        }
    }

    public static void main(String[] args) {

        System.out.println("SecureVote - Digital Voting & Election Analytics System");
        System.out.println("-------------------------------------------------------");

        List<Edge> edges = new ArrayList<>();

        edges.add(new Edge(0, 1, 4));
        edges.add(new Edge(0, 2, 2));
        edges.add(new Edge(1, 2, 3));
        edges.add(new Edge(1, 3, 2));
        edges.add(new Edge(1, 4, 3));
        edges.add(new Edge(2, 1, 1));
        edges.add(new Edge(2, 3, 4));
        edges.add(new Edge(3, 4, 2));

        System.out.println("\nElection Network Connections:");
        for (Edge edge : edges) {
            System.out.println(edge.source + " -> " +
                    edge.destination + " (Weight " +
                    edge.weight + ")");
        }

        bellmanFord(edges, 0);
    }
}
